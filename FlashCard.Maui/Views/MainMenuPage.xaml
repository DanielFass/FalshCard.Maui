<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="FlashCard.Maui.Views.MainMenuPage" Title="Flashcards">
    <Grid Padding="20" RowDefinitions="Auto,*">
        <HorizontalStackLayout Spacing="10">
            <Button Text="Add Deck" Command="{Binding AddDeckCommand}" />
            <Button Text="Add Words" Command="{Binding AddWordsCommand}" />
        </HorizontalStackLayout>
        <Grid Grid.Row="1">
            <CollectionView ItemsSource="{Binding Decks}" SelectionMode="Single" SelectionChanged="OnDeckSelected">
                <CollectionView.ItemTemplate><DataTemplate>
                    <Border Margin="0,8" Padding="16" StrokeShape="RoundRectangle 12" BackgroundColor="#EEF2F7">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{Binding Name}" FontSize="20" VerticalOptions="Center" TextColor="Black" />
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="{Binding CardCount, StringFormat='{0} words'}" TextColor="Black" />
                                <Button Text="Delete" Command="{Binding Source={RelativeSource AncestorType={x:Type CollectionView}}, Path=BindingContext.DeleteDeckCommand}" CommandParameter="{Binding .}" BackgroundColor="#B3261E" TextColor="White" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate></CollectionView.ItemTemplate>
            </CollectionView>
            <Label x:Name="EmptyMessage" Text="No decks yet - tap Add Deck to start" HorizontalOptions="Center" VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>

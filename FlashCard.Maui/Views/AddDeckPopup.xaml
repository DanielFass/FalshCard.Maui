<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit" x:Class="FlashCard.Maui.Views.AddDeckPopup">
    <VerticalStackLayout Padding="24" Spacing="12" BackgroundColor="White" WidthRequest="300">
        <Label Text="Add Deck" FontSize="24" TextColor="Black" />
        <Entry Placeholder="Deck name" Text="{Binding DeckName}" TextColor="Black" />
        <HorizontalStackLayout Spacing="10">
            <Button Text="Save" Command="{Binding SaveCommand}" />
            <Button Text="Cancel" Command="{Binding CancelCommand}" />
        </HorizontalStackLayout>
    </VerticalStackLayout>
</toolkit:Popup>

<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit" x:Class="FlashCard.Maui.Views.AddWordsPopup">
    <VerticalStackLayout Padding="24" Spacing="12" BackgroundColor="White" WidthRequest="320">
        <Label Text="Add Word" FontSize="24" TextColor="Black" />
        <Picker Title="Choose a deck" ItemsSource="{Binding Decks}" SelectedItem="{Binding SelectedDeck}" ItemDisplayBinding="{Binding Name}" BackgroundColor="#E6E6E6" TextColor="Black" TitleColor="#555555" />
        <Entry Placeholder="Front" Text="{Binding FrontText}" TextColor="Black" />
        <Entry Placeholder="Back" Text="{Binding BackText}" TextColor="Black" />
        <HorizontalStackLayout Spacing="10">
            <Button Text="Save" Command="{Binding SaveCommand}" />
            <Button Text="Cancel" Command="{Binding CancelCommand}" />
        </HorizontalStackLayout>
    </VerticalStackLayout>
</toolkit:Popup>
